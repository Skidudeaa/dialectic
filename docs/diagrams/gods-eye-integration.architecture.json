  "cards": [
    {
      "dot": "rose",
      "title": "The interjection gate",
      "items": [
        "A fire speaks only when novel vs the room's 30-day baseline, FRP ≥ 10 MW, confidence not low",
        "The daily cap is per layer — aircraft churn cannot silence a fire",
        "Recurring flare fields are named beside every new cell"
      ]
    },
    {
      "dot": "amber",
      "title": "Authority is a column",
      "items": [
        "geo_scopes: human_confirmed · source_reported · machine_proposed, append-only with lineage",
        "propose_geo_scope reuses existing geometry and always lands as a human-reviewed proposal",
        "Coordinates are never taken from the model"
      ]
    },
    {
      "dot": "emerald",
      "title": "Polite polling, durable contacts",
      "items": [
        "Each provider has its own kill switch and floor rate; FIRMS pixels merge to 0.01° cell-days",
        "usgs · adsb · launch · firms persist to world_observations; the ISS stays ephemeral",
        "Cesium ships as its own lazy chunk, outside the PWA precache"
      ]
    }
