<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.1.8">
  <diagram name="Dialectic Architecture">
    <mxGraphModel dx="1900" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Dialectic — system architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="8" width="760" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two humans and an LLM co-reason in real time. The LLM is a participant, not an assistant: it decides when to speak,&#xa;checks live market data with tools, remembers with attribution, and follows up on silence." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="900" y="8" width="940" height="40" as="geometry" />
        </mxCell>

        <mxCell id="clientLane" value="Client — the PWA is the reach strategy" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="800" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pwa" value="React 19 PWA&#xa;Vite 7 + TS 5.9 · Zustand&#xa;dialectic/frontend/app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="clientLane">
          <mxGeometry x="20" y="45" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="push" value="WebSocket stream + Web Push&#xa;live turns · presence · notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="clientLane">
          <mxGeometry x="410" y="45" width="370" height="85" as="geometry" />
        </mxCell>

        <mxCell id="anthropic" value="Anthropic API&#xa;Claude — the third participant" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="60" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="defuddle" value="defuddle.service&#xa;:8010 · article extraction&#xa;(read_article tool)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="180" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="tdspa" value="tradingDesk SPA — trading/frontend&#xa;separate Vite app · nginx → td.somacura.org&#xa;answers unknown GETs with 200 + HTML (check content-type, not status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1480" y="60" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mktdata" value="Market data providers" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1480" y="190" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="nginx" value="nginx&#xa;/var/www/dialectic-current  →  dialectic-releases/&lt;ts&gt;-&lt;name&gt;   —  the symlink flip IS the frontend release&#xa;proxies /ws/ (3600 s upgrade) and /auth /rooms /threads /memories /health … → 127.0.0.1:8002" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="800" height="80" as="geometry" />
        </mxCell>

        <mxCell id="dialectic" value="dialectic.service · :8002 · FastAPI   —   the live unit runs the git working tree (/root/DwoodAmo/dialectic, python3 run.py), so a restart deploys whatever is on disk" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="1120" height="480" as="geometry" />
        </mxCell>
        <mxCell id="api" value="api/ routers&#xa;auth · rooms · threads · home · workspace · attachments&#xa;prediction / reading / thesis relays" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="dialectic">
          <mxGeometry x="30" y="50" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="workspace" value="workspace_objects.py — the workroom projection&#xa;eight entity types → one read-only WorkspaceObject shape&#xa;adapters over entities that already exist, never a universal table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="dialectic">
          <mxGeometry x="30" y="140" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="memory" value="memory/manager.py&#xa;3-lane RRF recall (dense + FTS + speaker)&#xa;write-path dedup · supersession with history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="dialectic">
          <mxGeometry x="30" y="230" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" value="scheduler.py — the clock&#xa;PG advisory lock · scheduled_job_runs ledger · 30 s tick&#xa;9 jobs: heartbeat 600s · reconcile 900s · watchdog 1800s&#xa;wire 900s · predictions 3600s · reading echo 1800s · sweep 60s&#xa;morning brief 07:00 CT · news digest 05:30 CT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="dialectic">
          <mxGeometry x="30" y="330" width="380" height="110" as="geometry" />
        </mxCell>

        <mxCell id="llmlane" value="The LLM participant" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="dialectic">
          <mxGeometry x="450" y="50" width="640" height="330" as="geometry" />
        </mxCell>
        <mxCell id="orch" value="llm/orchestrator.py — three paths&#xa;@Claude streaming · heuristic non-streaming · forced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="llmlane">
          <mxGeometry x="20" y="40" width="600" height="64" as="geometry" />
        </mxCell>
        <mxCell id="toolloop" value="llm/tool_loop.py → llm/tools.py&#xa;15-tool registry (8 tradingDesk + 7 dialectic)&#xa;max 5 iterations · 60 s budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="llmlane">
          <mxGeometry x="20" y="130" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="selfmodel" value="llm/self_model.py&#xa;append-only decision log&#xa;— why it spoke, or didn't" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="llmlane">
          <mxGeometry x="330" y="130" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fsm" value="llm/participation_fsm.py&#xa;engaged · awaiting_human · question_pending&#xa;ignored · dormant  + confidence tiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="llmlane">
          <mxGeometry x="20" y="235" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="proactive" value="night_shift · silence_sweep · wire&#xa;prediction_watch · reading_echo&#xa;the LLM speaking unprompted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="llmlane">
          <mxGeometry x="330" y="235" width="290" height="70" as="geometry" />
        </mxCell>

        <mxCell id="td" value="tradingdesk.service · :8006 (loopback)&#xa;also runs its git working tree" style="swimlane;startSize=46;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1480" y="400" width="480" height="480" as="geometry" />
        </mxCell>
        <mxCell id="dag" value="causal-DAG thesis engine&#xa;+ live data service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="td">
          <mxGeometry x="30" y="60" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="coord" value="coordinator — 300 s tick&#xa;pushes a v3 snapshot when the tick produced events,&#xa;otherwise on the 3600 s heartbeat&#xa;failed pushes spool to snapshots/outbox/ (file spool)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="td">
          <mxGeometry x="30" y="145" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="bridgeapi" value="bridge API — /api/bridge&#xa;GET snapshot/{id} · GET news/{id}&#xa;POST room-token · POST room-unbind&#xa;⟵ all four gated on X-Service-Token&#xa;GET/POST outbox · outbox/replay ⟵ JWT (operator UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="td">
          <mxGeometry x="30" y="265" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="roomtokens" value="/var/lib/tradingdesk/room-tokens.env  (0600)&#xa;outside the git tree — registering a token needs no restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="td">
          <mxGeometry x="30" y="385" width="420" height="65" as="geometry" />
        </mxCell>

        <mxCell id="datalane" value="Data — PostgreSQL + pgvector (VECTOR(1024), Voyage) + pg_trgm" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="950" width="1120" height="200" as="geometry" />
        </mxCell>
        <mxCell id="events" value="events&#xa;append-only&#xa;source of truth" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="datalane">
          <mxGeometry x="30" y="50" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="derived" value="everything else is derivable&#xa;rooms (+linked_book_id, trading_config, is_home) · threads&#xa;messages (+metadata) · memories (+memory_versions) · attachments&#xa;room_memberships (+can_manage_home) · users · commitments&#xa;llm_decisions · llm_participation_state · scheduled_job_runs&#xa;web_push_subscriptions · room_personas · thread_protocols" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="datalane">
          <mxGeometry x="380" y="50" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="schema" value="schema.sql&#xa;fresh-DB baseline&#xa;(29 tables)&#xa;&#xa;migrations 001 → 016&#xa;013 = Home Base&#xa;016 = Voyage 1024-dim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="datalane">
          <mxGeometry x="890" y="50" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="sqlite" value="SQLite (WAL)&#xa;/var/lib/tradingdesk/tradingdesk.db&#xa;web/data/ path is a symlink to it" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1480" y="950" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="sidecar" value="cc-sidecar — lineage, not runtime&#xa;Nothing imports it and no unit runs it. It is the design ancestor of llm/participation_fsm.py&#xa;(reducer states) and llm/silence_sweep.py (daemon timers)." style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1190" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="frozen" value="packages/ (React Native)&#xa;FROZEN — cannot reach production&#xa;the PWA is the reach strategy instead" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="1190" width="430" height="90" as="geometry" />
        </mxCell>

