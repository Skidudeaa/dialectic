{
  "manifest_version": 3,
  "name": "Somacura Capture",
  "short_name": "Somacura",
  "version": "0.1.0",
  "description": "Capture the rendered page or selection as durable Markdown.",
  "action": {
    "default_title": "Save as Markdown",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
