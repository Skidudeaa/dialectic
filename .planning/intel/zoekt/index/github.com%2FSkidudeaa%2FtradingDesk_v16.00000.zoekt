        tg = make_thesisgraph_stub(tmp_path)
        diff = make_diff_stub(tmp_path, 1)
        push = make_push_stub(tmp_path)

        rc = run_main(["--books", str(books_dir)], bad_snapshots, tg, diff, push)
        assert rc == 2


