  "analogs": [
    {
      "id": "smoot-hawley",
      "name": "Smoot-Hawley Tariff Act (1930)",
      "similarity": "high (structure)",
      "startDate": "1930-06-17",
      "keyLags": {
        "tariff-to-retaliation": "6 months (24 countries within 2 years)",
