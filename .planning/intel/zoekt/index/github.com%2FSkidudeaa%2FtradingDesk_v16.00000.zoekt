}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trading Desk â€” Collaborative AI Trading</title>
<meta property="og:title" content="Trading Desk â€” Collaborative AI Trading">
<meta property="og:description" content="A causal reasoning engine for macro trading. Map your thesis as a graph. The AI holds it while you trade.">
<meta name="description" content="Causal reasoning engine for macro trading. Models transmission chains as directed graphs, propagates signals, and feeds everything into Dialectic for AI-augmented collaborative decisions.">
<!-- ARGUMENT
Claim: Trading Desk is a collaborative AI trading desk â€” a causal reasoning engine that maps macro
transmission chains as directed graphs, propagates signals, and feeds everything into Dialectic so
the LLM becomes a fully-informed third participant in your trading discussions.
Evidence: Working system with 2 active theses (31 nodes, 32 edges), live data from Yahoo Finance +
Polymarket, 5-tab interactive dashboards, snapshot export, delta detection, and Dialectic integration
with LLM context injection and async curator alerts. $14K/mo budget across two theses. 118 tests.
So what: Every macro trader thinks in causal chains. Nobody has a tool that maps them, enforces them,
and brings the AI into the conversation with full context. Now we do.
Decision rule: Use this system for collaborative macro positioning with full AI context.
-->
<!-- DESIGN BRIEF
Archetype: Architecture Flow (D)
Entity colors: thesis=#FF6B35, data=#4CC4B4, dashboard=#E69A4C, dialectic=#A78BFA, alerts=#C44C4C
Ambient hue: 30 (warm dark roast)
Focal entity: Dialectic (#A78BFA)
Flags: bento
Annotations: 1.bottleneck 2.critical-path(breakout) 3.failure-mode
Dynamics: fortissimo(cascade) â†’ piano â†’ mezzo-forte(pipeline) â†’ forte(dialectic) â†’ mezzo-piano(discipline)
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg0:#120C06;--bg1:#160E08;
  --s0:rgba(255,255,255,0.04);--s1:rgba(255,255,255,0.06);--s2:rgba(255,255,255,0.09);
  --b0:rgba(255,255,255,0.050);--b1:rgba(255,255,255,0.085);
  --r-sm:6px;--r-md:14px;--r-lg:18px;
  --sp-2:8px;--sp-3:12px;--sp-4:16px;--sp-6:24px;--sp-8:32px;
  --rhythm-beat:24px;--rhythm-breath:48px;--rhythm-rest:80px;--rhythm-accent:120px;--rhythm-coda:64px;
  --ambient-hue:30;--ambient-sat:40%;--ambient-lum:8%;--ambient-opacity:0.12;
  --focal-entity-color:#A78BFA;
  --e-out:cubic-bezier(0.22,1,0.36,1);--dur-fast:0.2s;--dur-med:0.35s;
  --t1:#FFF7EE;--t2:rgba(255,247,238,0.72);--t3:rgba(255,247,238,0.50);--t4:rgba(255,247,238,0.38);
  --font-display:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  --font-mono:'Fira Code','SF Mono',monospace;
  --c-fire:#FF6B35;--c-data:#4CC4B4;--c-dash:#E69A4C;--c-dial:#A78BFA;--c-alert:#C44C4C;
  --c-fire-dim:rgba(255,107,53,0.12);--c-data-dim:rgba(76,196,180,0.12);
  --c-dash-dim:rgba(230,154,76,0.12);--c-dial-dim:rgba(167,139,250,0.12);--c-alert-dim:rgba(196,76,76,0.12);
  --transition-duration:0.35s;
}
html{font-size:16px;scroll-behavior:smooth}
body{
  font-family:var(--font-display);color:var(--t1);line-height:1.6;
  background:var(--bg0);
  background-image:radial-gradient(ellipse at 50% 0%,hsla(var(--ambient-hue),var(--ambient-sat),var(--ambient-lum),var(--ambient-opacity)) 0%,transparent 70%);
  min-height:100vh;-webkit-font-smoothing:antialiased;
}

/* Sentiment strip */
.sentinel{position:fixed;top:0;left:0;right:0;height:3px;background:var(--focal-entity-color);z-index:100}

/* Layout */
.container{max-width:1100px;margin:0 auto;padding:0 var(--sp-6)}
.full-bleed{width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw}

/* Typography */
h1{font-size:clamp(2.5rem,6vw,4rem);font-weight:900;letter-spacing:-0.03em;line-height:1.05}
h2{font-size:clamp(1.25rem,3vw,1.75rem);font-weight:700;letter-spacing:-0.02em;line-height:1.2}
h3{font-size:1.125rem;font-weight:600;line-height:1.3}
.mono{font-family:var(--font-mono);font-size:0.875em}
.t2{color:var(--t2)}.t3{color:var(--t3)}.t4{color:var(--t4)}

/* Act 1: Hero */
.hero{padding:calc(var(--rhythm-accent) + 3px) 0 var(--rhythm-rest);text-align:center}
.hero-label{
  display:inline-block;font-size:0.6875rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;
  color:var(--c-fire);border:1px solid rgba(255,107,53,0.3);border-radius:var(--r-sm);
  padding:var(--sp-2) var(--sp-4);margin-bottom:var(--sp-6);
}
.hero-title{margin-bottom:var(--sp-4)}
.hero-title span{
  background:linear-gradient(135deg,var(--c-fire),var(--c-dash));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.hero-sub{font-size:clamp(1rem,2vw,1.25rem);color:var(--t2);max-width:680px;margin:0 auto var(--rhythm-breath)}
.hero-stats{display:flex;justify-content:center;gap:clamp(24px,5vw,64px);flex-wrap:wrap;margin-bottom:var(--sp-6)}
.hero-stat .num{font-family:var(--font-mono);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:800;color:var(--t1);display:block}
.hero-stat .label{font-size:0.75rem;color:var(--t3);text-transform:uppercase;letter-spacing:0.1em}
.hero-meta{font-size:0.75rem;color:var(--t4)}

/* Section spacing */
section[data-act="2"]{padding-bottom:var(--rhythm-rest)}
.section-head{margin-bottom:var(--rhythm-breath)}
.section-head h2{margin-bottom:var(--sp-2)}
.section-head p{color:var(--t3);max-width:600px}

/* Annotation callout */
.callout{
  border-left:3px solid var(--c-fire);padding:var(--sp-4) var(--sp-6);
  background:var(--s0);border-radius:0 var(--r-sm) var(--r-sm) 0;
  margin-bottom:var(--rhythm-breath);font-size:0.9375rem;color:var(--t2);
  max-width:700px;
}
.callout .type{font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--c-fire);margin-bottom:var(--sp-2);display:block}

/* Cascade SVG */
.cascade-wrap{
  background:var(--s0);border:1px solid var(--b0);border-radius:var(--r-lg);
  padding:var(--sp-6);overflow-x:auto;margin-bottom:var(--sp-6);
}
.cascade-svg{width:100%;height:auto;min-width:700px}
.cascade-legend{display:flex;gap:var(--sp-6);flex-wrap:wrap;padding:var(--sp-4) 0 0;font-size:0.75rem;color:var(--t3)}
.legend-item{display:flex;align-items:center;gap:var(--sp-2)}
.legend-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}

/* Breathing room */
.breath{
  text-align:center;padding:var(--rhythm-accent) 0;
  font-size:1.0625rem;color:var(--t3);font-style:italic;
}
.breath .divider{
  width:60px;height:1px;background:var(--b1);margin:0 auto var(--sp-6);
}

/* Pipeline grid */
.pipeline{
  display:grid;grid-template-columns:repeat(3,1fr);gap:var(--rhythm-beat);
  margin-bottom:var(--rhythm-rest);
}
.stage{
  background:var(--s0);border:1px solid var(--b0);border-radius:var(--r-md);
  padding:var(--sp-6);position:relative;transition:border-color var(--dur-fast) var(--e-out),background var(--dur-fast) var(--e-out);
}
.stage:hover{background:var(--s1);border-color:var(--b1)}
.stage-num{
  font-family:var(--font-mono);font-size:0.6875rem;font-weight:600;
  width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  margin-bottom:var(--sp-3);
}
.stage h3{margin-bottom:var(--sp-2)}
.stage .metric{
  font-family:var(--font-mono);font-size:0.8125rem;color:var(--t3);margin-bottom:var(--sp-3);
}
.stage p{font-size:0.875rem;color:var(--t2);line-height:1.5}
.stage-arrow{
  display:none;position:absolute;right:-16px;top:50%;transform:translateY(-50%);
  color:var(--t4);font-size:1.25rem;
}

/* Breakout */
.breakout{
  width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;
  background:linear-gradient(180deg,rgba(167,139,250,0.06) 0%,transparent 100%);
  border-top:1px solid rgba(167,139,250,0.15);border-bottom:1px solid rgba(167,139,250,0.15);
  padding:var(--rhythm-accent) 0;margin-bottom:var(--rhythm-rest);
}
.breakout-inner{max-width:900px;margin:0 auto;padding:0 var(--sp-6)}
.breakout h2{text-align:center;margin-bottom:var(--sp-3)}
.breakout h2 span{color:var(--c-dial)}
.breakout-sub{text-align:center;color:var(--t3);margin-bottom:var(--rhythm-breath);font-size:0.9375rem}

/* Chat mockup */
.chat{display:flex;flex-direction:column;gap:var(--sp-4);max-width:720px;margin:0 auto}
.chat-msg{
  border-radius:var(--r-md);padding:var(--sp-4) var(--sp-6);
  max-width:88%;font-size:0.9375rem;line-height:1.6;
}
.chat-msg .sender{font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:var(--sp-2);display:block}
.chat-dan{
  background:var(--s1);border:1px solid var(--b1);align-self:flex-start;
}
.chat-dan .sender{color:var(--c-dash)}
.chat-ai{
  background:var(--c-dial-dim);border:1px solid rgba(167,139,250,0.2);align-self:flex-end;
}
.chat-ai .sender{color:var(--c-dial)}
.chat-ai .detail{font-family:var(--font-mono);font-size:0.8125rem;color:var(--t2);display:block;margin-top:var(--sp-2)}
.chat-curator{
  background:var(--c-alert-dim);border:1px solid rgba(196,76,76,0.2);
  align-self:center;max-width:100%;text-align:center;
}
.chat-curator .sender{color:var(--c-alert)}
.chat-curator .time{font-family:var(--font-mono);font-size:0.6875rem;color:var(--t4);margin-left:var(--sp-2)}

/* Bento capabilities grid */
.bento{display:grid;grid-template-columns:repeat(6,1fr);gap:var(--rhythm-beat);margin-bottom:var(--rhythm-rest)}
.bento-card{
  background:var(--s0);border:1px solid var(--b0);border-radius:var(--r-md);padding:var(--sp-6);
  transition:border-color var(--dur-fast) var(--e-out),background var(--dur-fast) var(--e-out);
}
.bento-card:hover{background:var(--s1);border-color:var(--b1)}
.bento-card--featured{grid-column:span 6}
.bento-card--wide{grid-column:span 4}
.bento-card--half{grid-column:span 3}
.bento-card--narrow{grid-column:span 2}
.bento-card .icon{font-size:1.5rem;margin-bottom:var(--sp-3);display:block}
.bento-card h3{margin-bottom:var(--sp-2)}
.bento-card .detail{font-size:0.875rem;color:var(--t2);line-height:1.5}
.bento-card .example{
  font-family:var(--font-mono);font-size:0.8125rem;color:var(--t3);
  margin-top:var(--sp-3);padding-top:var(--sp-3);border-top:1px solid var(--b0);
}

/* Act 3: Close */
.close{text-align:center;padding:var(--rhythm-rest) 0 var(--rhythm-breath)}
.close-statement{
  font-size:clamp(1rem,2.5vw,1.375rem);color:var(--t2);max-width:780px;
  margin:0 auto var(--rhythm-breath);line-height:1.7;
}
.close-punch{
  font-size:clamp(1.5rem,4vw,2.5rem);font-weight:800;
  background:linear-gradient(135deg,var(--c-fire),var(--c-dial));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  margin-bottom:var(--rhythm-breath);
}
.tech-specs{
  display:flex;justify-content:center;gap:var(--sp-8);flex-wrap:wrap;
  font-family:var(--font-mono);font-size:0.8125rem;color:var(--t3);
  margin-bottom:var(--rhythm-coda);
}
.tech-spec{text-align:center}
.tech-spec strong{color:var(--t2);display:block;font-size:1rem}

/* Provenance */
.provenance{
  border-top:1px solid var(--b0);padding:var(--rhythm-coda) 0 var(--rhythm-rest);
  font-size:0.75rem;color:var(--t4);text-align:center;
}
.provenance p{margin-bottom:var(--sp-2);max-width:700px;margin-left:auto;margin-right:auto}

/* Reveals */
.reveal{opacity:0;transform:translateY(16px);transition:opacity var(--transition-duration) var(--e-out),transform var(--transition-duration) var(--e-out)}
.reveal-entering{opacity:0.4;transform:translateY(8px)}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-left{transform:translateX(-20px)}
.reveal-left.visible{transform:translateX(0)}
.reveal-right{transform:translateX(20px)}
.reveal-right.visible{transform:translateX(0)}
.reveal-stagger>*:nth-child(1){transition-delay:0ms}
.reveal-stagger>*:nth-child(2){transition-delay:60ms}
.reveal-stagger>*:nth-child(3){transition-delay:120ms}
.reveal-stagger>*:nth-child(4){transition-delay:180ms}
.reveal-stagger>*:nth-child(5){transition-delay:240ms}
.reveal-stagger>*:nth-child(n+6){transition-delay:300ms}

/* A11y */
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
button:focus-visible,.bento-card:focus-visible{outline:2px solid var(--c-dial);outline-offset:2px}

/* Print */
@media print{
  .no-print,.sentinel{display:none!important}
  body{background:#fff!important;color:#000!important}
  .hero-title span,.close-punch{-webkit-text-fill-color:#000!important;color:#000!important}
  .cascade-wrap,.stage,.bento-card,.chat-msg{border-color:#ccc!important;background:#f9f9f9!important}
  .breakout{background:none!important;border-color:#ccc!important}
  .callout{border-left-color:#333!important;background:#f5f5f5!important}
  .t2,.t3,.t4,p{color:#333!important}
  .reveal{opacity:1!important;transform:none!important}
}

/* Responsive */
@media(max-width:768px){
  .pipeline{grid-template-columns:1fr}
  .bento{grid-template-columns:1fr}
  .bento-card--featured,.bento-card--wide,.bento-card--half,.bento-card--narrow{grid-column:span 1}
  .hero-stats{flex-direction:column;gap:var(--sp-6)}
  .tech-specs{flex-direction:column;gap:var(--sp-4)}
  .chat-msg{max-width:100%}
  .container{padding:0 var(--sp-4)}
  .cascade-wrap{padding:var(--sp-4);margin-left:calc(-1 * var(--sp-4));margin-right:calc(-1 * var(--sp-4));border-radius:0}
  --rhythm-beat:16px;--rhythm-breath:32px;--rhythm-rest:56px;--rhythm-accent:80px;
}
@media(min-width:769px){
  .stage-arrow{display:block}
  .pipeline{position:relative}
}
@media(min-width:769px) and (max-width:1024px){
  .pipeline{grid-template-columns:repeat(2,1fr)}
  .bento{grid-template-columns:repeat(2,1fr)}
  .bento-card--featured{grid-column:span 2}
  .bento-card--wide,.bento-card--half{grid-column:span 1}
}
</style>
</head>
<body>

<div class="sentinel" aria-hidden="true"></div>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• ACT 1: HERO â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<section data-act="1" class="hero">
  <div class="container">
    <div class="hero-label">Architecture Flow</div>
    <h1 class="hero-title"><span>Trading Desk</span></h1>
    <p class="hero-sub">A causal reasoning engine for macro trading. Model your thesis as a directed graph. Propagate the signals. Let the AI hold the graph while you trade.</p>
    <div class="hero-stats">
      <div class="hero-stat">
