@import "tailwindcss";

@theme {
  --color-void: #0a0a0a;
  --color-surface: #111111;
  --color-elevated: #1a1a1a;
  --color-border: #2a2a2a;
  --color-amber: #d4a843;
  --color-amber-dim: #a07c2e;
  --color-teal: #2dd4bf;
  --color-teal-dim: #1a9e8f;
  --color-danger: #ef4444;
  --color-text-primary: #e5e5e5;
  --color-text-muted: #a3a3a3;
  --color-text-dim: #6b6b6b;
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;
  --font-sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
}

@layer base {
  body {
    @apply bg-void text-text-primary font-sans antialiased;
    font-size: 14px;
    line-height: 1.5;
  }

  * {
    @apply border-border;
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    @apply bg-border rounded-full;
  }
  ::-webkit-scrollbar-thumb:hover {
    @apply bg-text-dim;
  }
}

