      "deadline": "2026-04-15",
      "conditions": ["fert-shortage.active", "diesel.above_5.50"],
      "logic": "any",
      "irreversible": true,
      "countdown": true,
      "context": "US corn belt: mid-April to mid-May window. 93M acres. Nitrogen is the limiting nutrient. If missed, that crop is gone. 17 days remaining."
    },
