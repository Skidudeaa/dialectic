# ┌──────────────────────────────────────────────────────────────────────────┐
# │ TOMBSTONE 2026-08-13 — THIS FILE IS NOT WHAT RUNS IN PRODUCTION.         │
# └──────────────────────────────────────────────────────────────────────────┘
# The unit systemd actually loads is /etc/systemd/system/dialectic.service:
#
#     WorkingDirectory=/root/DwoodAmo/dialectic
#     ExecStart=/usr/bin/python3 run.py
#
# i.e. the live service runs the git working tree directly (the CLAUDE.md house
# rule "both systemd units run their git working trees" describes THAT unit, and
# is correct). Everything below describes an /opt/dialectic/current release-
# symlink deploy that was designed but never built: /opt/dialectic does not
# exist on this host, and neither does the venv or the EnvironmentFile it names.
#
# WHY THIS IS DANGEROUS, not merely stale: a deploy that copied these paths would
# point systemd at a directory that isn't there, and a reader comparing it against
# the running service would conclude the working-tree rule had been superseded.
# It has not been.
#
# Kept rather than deleted because it is the only written record of the intended
# release-symlink design (the frontend half of which IS live — see
# /var/www/dialectic-current). If that design is ever built, this is the starting
# point; until then, do not install it. Verify with `systemctl cat dialectic`
# before trusting any path in this file.

[Unit]
Description=Dialectic backend (FastAPI + dialogue engine)
Documentation=file:///opt/dialectic/current/dialectic/README.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target redis-server.service
# Leave a crash breadcrumb if the loop flaps.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dialectic/current/dialectic
Environment=HOST=127.0.0.1
Environment=PORT=8002
Environment=WEB_CONCURRENCY=2
EnvironmentFile=/etc/dialectic/dialectic.env
ExecStart=/opt/dialectic/current/dialectic/venv/bin/uvicorn api.main:app --host ${HOST} --port ${PORT} --workers ${WEB_CONCURRENCY} --proxy-headers --forwarded-allow-ips=127.0.0.1
UMask=0077
# Restart on crash AND on kill; 5s backoff to avoid tight loops on broken configs
Restart=always
RestartSec=5
# Graceful shutdown window — lets in-flight WebSocket sessions drain before SIGKILL
TimeoutStopSec=15
# Structured logging to journalctl -u dialectic
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dialectic

[Install]
WantedBy=multi-user.target
