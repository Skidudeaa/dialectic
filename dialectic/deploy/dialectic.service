[Unit]
Description=Dialectic backend (FastAPI + dialogue engine)
Documentation=file:///opt/dialectic/current/dialectic/README.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target redis-server.service
# Leave a crash breadcrumb if the loop flaps.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dialectic/current/dialectic
Environment=HOST=127.0.0.1
Environment=PORT=8002
Environment=WEB_CONCURRENCY=2
EnvironmentFile=/etc/dialectic/dialectic.env
ExecStart=/opt/dialectic/current/dialectic/venv/bin/uvicorn api.main:app --host ${HOST} --port ${PORT} --workers ${WEB_CONCURRENCY} --proxy-headers --forwarded-allow-ips=127.0.0.1
UMask=0077
# Restart on crash AND on kill; 5s backoff to avoid tight loops on broken configs
Restart=always
RestartSec=5
# Graceful shutdown window — lets in-flight WebSocket sessions drain before SIGKILL
TimeoutStopSec=15
# Structured logging to journalctl -u dialectic
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dialectic

[Install]
WantedBy=multi-user.target
