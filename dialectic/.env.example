# ============================================================
# Dialectic — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- REQUIRED ----

# PostgreSQL connection string
DATABASE_URL=postgresql://dialectic_app:change-me@127.0.0.1/dialectic

# Anthropic API key (primary LLM provider)
ANTHROPIC_API_KEY=sk-ant-...

# JWT signing secret. Required for signup, login, and token refresh.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-random-64-character-hex-value

# ---- OPTIONAL ----

# OpenAI API key (fallback LLM + vector embeddings)
# Without this, LLM fallback and semantic memory search won't work.
OPENAI_API_KEY=sk-...

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Bind address and port. Production should stay on loopback behind nginx.
HOST=127.0.0.1
PORT=8002

# Production mode (disables reload, uses multiple workers)
PRODUCTION=1

# Number of uvicorn workers in production mode
WEB_CONCURRENCY=2

# Required when WEB_CONCURRENCY is greater than 1 so all workers share
# WebSocket broadcasts. May be omitted only for a single-process dev server.
REDIS_URL=redis://127.0.0.1:6379

# ── reading organ ────────────────────────────────────────────
# Night-shift news digest (05:30 America/Chicago): defuddles fresh headlines
# per linked room, Haiku-distills them against the thesis, files to the
# reading library. Default on; set to 0 to disable.
NEWS_DIGEST_ENABLED=1

# The wire (15-min poller): scores fresh headlines against the live thesis,
# files the hits and posts a facilitator interjection. Default on; set to 0 to disable.
WIRE_ENABLED=1

# The RSS wire (15-min poller): rooms.watchlist {type:"rss"} feeds, scored and
# filed like the wire — and sharing its interjection budget by construction.
RSS_WIRE_ENABLED=1

# Per-publisher cap on each wire scan (bias control: no single domain may fill
# a run). Applies to wire and rss_wire alike.
WIRE_DOMAIN_CAP=2

# One thesis-independent broad-macro pull per news digest run (bias control:
# the exploration lane that keeps an oil-and-gold room hearing about the rest
# of the world). Default on.
NEWS_EXPLORATION_ENABLED=1

# Congressional stock-disclosure watch (hourly): files matching disclosures as
# congress:// readings in bound rooms. SHIPS DARK — verify the community
# dataset URLs live before arming.
CONGRESS_WATCH_ENABLED=0

# Prediction deadline watch (hourly): gathers evidence for due logged
# predictions and posts a resolution-proposal card the human settles.
# Default on; set to 0 to disable.
PREDICTION_WATCH_ENABLED=1

# Cross-session echo (30-min job): a reading that bears on another room's
# thesis lands there as an annotator note + memory reference. Default on; set to 0 to disable.
READING_ECHO_ENABLED=1

# ── the World Lens live signals ───────────────────────────────

# World signal adapters (120s job): keyless public feeds polled for the areas
# your rooms have actually placed on the map. Ephemeral only -- a signal
# expires on its own and never becomes geography without a human placing it.
# Master switch; each provider also has its own, and each has its own poll
# floor (see docs/WORLD_PROVIDERS.md for the terms of every feed).
WORLD_SIGNALS_ENABLED=1

WORLD_SIGNALS_USGS_ENABLED=1     # earthquakes, USGS all_day GeoJSON
WORLD_SIGNALS_ADSB_ENABLED=1     # live aircraft, adsb.lol (ODbL)
WORLD_SIGNALS_ISS_ENABLED=1      # the ISS, wheretheiss.at
WORLD_SIGNALS_LAUNCH_ENABLED=1   # upcoming launches, Launch Library 2
WORLD_SIGNALS_FIRMS_ENABLED=1    # active fires -- DARK without the key below

# NASA FIRMS active fire detections need a free MAP_KEY:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Unset, the fires layer reports "not configured" and never calls out.
# FIRMS_MAP_KEY=

# ── reading organ ─────────────────────────────────────────────

# Claim check: human messages linking an article get a background verdict
# (defuddle sidecar + one Haiku call); mixed/misrepresented lands a badge,
# everything else stays silent. Default on; set to 0 to disable.
CLAIM_CHECK_ENABLED=1

# Research mode: the composer's Research button runs a long tool loop
# (15 iterations / 300s) and lands a sourced brief as an llm_primary
# message. Default on; set to 0 to disable.
DEEP_DIVE_ENABLED=1

# Cairn dev memory: read-only tools over Amo's passively captured dev
# sessions (the cairn backend on this host). Safe to install later or omit
# entirely — a down cairn surfaces as a tool error, never a dead turn.
# CAIRN_URL=http://127.0.0.1:9000
CAIRN_TOOLS_ENABLED=1

# ── how much the participant talks ────────────────────────────
# All three were set against a week of real llm_decisions rows (2026-08-08..15),
# where the room ran 2.06 machine messages per human turn. Raise to speak less.

# Semantic novelty needed for an unprompted interjection. Was 0.70, which sat
# inside the bulk of the distribution (silent rows ran 0.32-0.69, firing rows
# 0.71-1.00 — one continuous population, no gap) and was the single largest
# source of speech. 0.85 puts the bar in the actual tail.
INTERJECTION_NOVELTY_THRESHOLD=0.85

# Speakers required before the balance-redirect rule can fire. Was effectively
# 2, which made it fire on any two-person window where one person took a few
# turns in a row. The rule needs a third party to redirect toward.
INTERJECTION_BALANCE_MIN_SPEAKERS=3

# The annotator fires whenever nobody else is online — near-permanent in a
# two-person room — so without a gate it wrote one note per message and became
# 122 of 214 machine messages.
#
# The WORTH gate is the volume control: the annotator's job is to connect this
# message to what the room already knows, so when recall finds nothing to
# connect it to there is no breadcrumb to leave. Measured over the same week,
# of 104 human messages: 15 fell below the substance floor, 34 more returned no
# memories, and 55 (53%) returned >=1 — roughly halving annotation volume.
# Raise MIN_MEMORY_HITS to 2 for a stricter room (41%). Recall failure is
# treated as "stay silent" — a degraded lane must not become noise.
ANNOTATOR_MIN_MEMORY_HITS=1
ANNOTATOR_MIN_CHARS=25

# Annotations per room per UTC day. This is a RUNAWAY CEILING, not the volume
# control — measured against that week, a cap of 12 would have cut 2 of 126.
# 0 disables annotation entirely.
ANNOTATOR_DAILY_CAP=12

# Embeddings — Voyage is preferred when set; OpenAI is the fallback.
# Changing model means a column migration + full re-embed (migrations/016).
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-4-large
VOYAGE_EMBED_DIM=1024
