# === Required ===
# JWT secret for auth tokens — change in production
JWT_SECRET=tradingdesk-dev-secret-change-me

# Password for dev users (amo, dan)
DEV_USER_PASSWORD=changeme

# === Optional (for LLM features) ===
# OpenRouter API key — enables @claude/@gpt/@compare chat
OPENROUTER_API_KEY=

# === Existing CLI tools ===
# Dialectic room push token (used by tools/bridge/push-to-dialectic.py)
DIALECTIC_ROOM_TOKEN=

# === TradingView webhook integration ===
# Required to enable POST /api/tradingview/webhook. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotate by clearing the value (route returns 500) then setting a new one.
TV_WEBHOOK_SECRET=

# Per-IP rate limit for the webhook endpoint. Defaults to 60/min.
TV_WEBHOOK_RATE_LIMIT_PER_MIN=60

# Nonce retention window. Defaults to 600 seconds (10 minutes).
# MUST be >= the ±300s timestamp skew window.
TV_WEBHOOK_NONCE_TTL_SECONDS=600

# === Slow data feeds (optional — the desk runs without them) ===
# Paste a key and restart the service to light the fred-/eia-sourced nodes;
# with the line commented out the coordinator never even attempts the call.
# Free keys: https://fred.stlouisfed.org/docs/api/api_key.html
#            https://www.eia.gov/opendata/register.php
# FRED_API_KEY=
# EIA_API_KEY=
