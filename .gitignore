# JavaScript package installs
node_modules/

# Yarn's machine-local install metadata
**/.yarn/install-state.gz

# Generated build output
dist/
# The Safari converter consumes this reviewed extension bundle directly; it is
# a release input, not an incidental frontend build directory.
!capture-ios/web-extension/dist/
!capture-ios/web-extension/dist/**
*.tsbuildinfo

# Generated planning/search indexes
.planning/intel/
**/.planning/intel/

# Browser automation artifacts
.playwright-mcp/
**/.playwright-mcp/

# Codex feature worktrees
.worktrees/

# Local Adjudicate batch artifacts
.adjudicate/

# Machine-local agent hook wiring (sextant); not shared config
.claude/settings.json
**/.claude/settings.json

# Compiled Go binaries (build with `go build ./cmd/...`)
cc-sidecar/cmd/cc-sidecar-emit/cc-sidecar-emit

# Browser-proof screenshots and design bundles kept out of the tree
/*.png
/*.zip
